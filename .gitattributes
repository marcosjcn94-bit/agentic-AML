# Lockfiles e código gerado: `git diff` mostra só "Binary files differ",
# cortando tokens de qualquer revisor que leia o diff. Espelha .reviewignore.
# Para ver o conteúdo mesmo assim: git diff --text <arquivo>
poetry.lock -diff linguist-generated=true
uv.lock -diff linguist-generated=true
Pipfile.lock -diff linguist-generated=true
pdm.lock -diff linguist-generated=true
package-lock.json -diff linguist-generated=true
yarn.lock -diff linguist-generated=true
pnpm-lock.yaml -diff linguist-generated=true
**/migrations/** linguist-generated=true
**/alembic/versions/** linguist-generated=true
*_pb2.py -diff linguist-generated=true
*_pb2_grpc.py -diff linguist-generated=true
